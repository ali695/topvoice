# VoiceGen Studio — Backend Environment Variables
# Copy this file to .env and fill in your values

# ── TTS Provider ──────────────────────────────────────────────────────────────
# Options: mock | external_api | local_model
# Use 'mock' for local development (no API key required)
# Use 'external_api' for production with a real TTS API
TTS_PROVIDER=mock

# API key for your TTS provider (required when TTS_PROVIDER=external_api)
# Supports ElevenLabs, OpenAI TTS, Google Cloud TTS, Azure, etc.
# NEVER commit this key to version control!
TTS_API_KEY=

# Optional: Custom TTS provider base URL
# TTS_API_BASE_URL=https://api.elevenlabs.io/v1

# Optional: Specific voice ID for your TTS provider
# TTS_API_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Audio Storage ─────────────────────────────────────────────────────────────
# Local path to store generated audio files
# In production, consider using cloud storage (S3, R2, etc.)
AUDIO_STORAGE_PATH=./audio_storage

# ── Database (Optional) ───────────────────────────────────────────────────────
# If not set, uses in-memory storage (resets on restart)
# DATABASE_URL=postgresql://user:password@localhost:5432/voicegen

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL (used for CORS configuration)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-app.vercel.app
